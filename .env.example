# Copier vers .env en local (ne pas committer .env)
SECRET_KEY=change-me-long-random-string
KASOFT_ADMIN_PIN=2026
KASOFT_MOURAKIB_PIN=3030
# KASOFT_PIN = alias de KASOFT_ADMIN_PIN (rétrocompatibilité)
# Phase 2 — PostgreSQL (optionnel ; SQLite par défaut)
# DATABASE_URL=postgresql://user:pass@localhost:5432/kasoft
KASOFT_PHASE2=1
# Phase 3 — URL publique pour QR /verify (ex. Oracle)
# KASOFT_PUBLIC_URL=http://51.170.128.73
ASSET_VERSION=41
FLASK_DEBUG=0
# Sur HTTP (ex. Oracle IP) laisser à 0. Sur HTTPS uniquement :
# SESSION_COOKIE_SECURE=1
# KASOFT_HTTPS=1
